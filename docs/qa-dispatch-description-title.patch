+test('完整说明成为标题并在重复同步时按单号去重', async () => {
+  const description = '问题与修复说明\n' + '中'.repeat(19992);
+  const tasks: any[] = [];
+  const server = http.createServer(async (req, res) => {
+    res.setHeader('Content-Type', 'application/json');
+    let data: any;
+    if (req.url === '/api/auth/login') data = { access_token: 'test-token' };
+    else if (req.url === '/api/projects') data = [{ id: 1, code: 'nami_pc' }];
+    else if (req.method === 'GET' && req.url === '/api/tasks?project_id=1') data = tasks;
+    else if (req.method === 'POST' && req.url === '/api/tasks') {
+      const chunks = [];
+      for await (const chunk of req) chunks.push(chunk);
+      const payload = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+      data = { ...payload, id: 51 }; tasks.push(data);
+    } else { res.statusCode = 404; res.end('{}'); return; }
+    res.end(JSON.stringify({ code: 0, data }));
+  });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  const cfg: PlatformConfig = { enabled: true, baseUrl: `http://127.0.0.1:${(server.address() as any).port}`,
+    projectCode: 'nami_pc', username: 'user', password: 'test' };
+  const item = { ...entry, assignee: 'unassigned', description };
+  try {
+    assert.equal((await reportEntries(cfg, [item])).created, 1);
+    assert.equal(tasks[0].title, description);
+    assert.equal(tasks[0].assigned_to, null);
+    assert.equal(findTaskIdByTicketId(tasks, entry.ticketId), 51);
+    const repeated = await reportEntries(cfg, [item]);
+    assert.equal(repeated.created, 0);
+    assert.deepEqual(repeated.alreadyExists, [entry.ticketId]);
+    assert.equal(tasks.length, 1);
+    assert.equal(buildTaskTitle({ ...entry, description: '  ' }), '【支付】提测 JIRA-123');
+  } finally { await new Promise<void>(resolve => server.close(() => resolve())); }
+});
