# ===== 测试管理平台 后端配置 =====
# 数据库：生产用 MySQL，本地冒烟可用 SQLite（注释切换）
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://tp:tp123@localhost:3306/test_platform?charset=utf8mb4
# SQLite 本地冒烟：
DATABASE_URL=sqlite:///./test_platform.db

# JWT
JWT_SECRET=please-change-this-secret-in-production
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS（前端地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 默认种子管理员（首次启动自动创建）
SEED_ADMIN_USERNAME=lixueyuan
SEED_ADMIN_PASSWORD=lixueyuan123
SEED_ADMIN_NAME=lixueyuan
