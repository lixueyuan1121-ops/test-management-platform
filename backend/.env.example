# ===== 测试管理平台 后端配置 =====
# 数据库：二选一。
# 1) MySQL（部署推荐）：设 DB_HOST 即启用，密码含 # ^ ! * 等特殊字符无需手动 URL 编码。
# DB_HOST=10.0.0.10
# DB_PORT=3306
# DB_USER=tp
# DB_PASSWORD=your-password
# DB_NAME=test_platform
# DB_CHARSET=utf8mb4
# 2) 整串（未设 DB_HOST 时生效）：默认 SQLite 本地开箱即用。
DATABASE_URL=sqlite:///./test_platform.db

# JWT
JWT_SECRET=please-change-this-secret-in-production
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS（前端地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 默认种子管理员（首次启动自动创建）
SEED_ADMIN_USERNAME=lixueyuan
SEED_ADMIN_PASSWORD=lixueyuan123
SEED_ADMIN_NAME=lixueyuan

# ===== 本地执行 runner（勾选用例下发目标机执行）=====
# runner 无人值守进程用的固定长期 token（与用户 JWT 分离）。生成一个长随机串，
# 并在各执行机 tools/qalab-runner/.env 的 RUNNER_TOKEN 填相同值。留空则拒绝一切 runner 请求。
RUNNER_TOKEN=

# ===== 飞书 OpenAPI（AI 测试助手读取飞书需求文档，可选）=====
# 在 https://open.feishu.cn 建「企业自建应用」，开通 docx/wiki/sheets/bitable 读权限，
# 并把目标文档共享给该应用，再填下面两项。留空则不支持飞书链接（普通网页不受影响）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# FEISHU_BASE=https://open.feishu.cn

# ===== 飞书通知（群机器人 webhook 推卡片，可选）=====
# 在飞书群里添加「自定义机器人」，复制 webhook URL 粘到下面。未配 URL 则整条通道静默关闭。
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx
# FEISHU_WEBHOOK_SECRET=                      # 群机器人开了签名校验才需要填
# PLATFORM_BASE_URL=http://10.0.0.5:4173     # 卡片按钮回跳平台的基址，留空则卡片无按钮
# NOTIFY_EXEC_FAIL=true                       # 自动回归批次失败告警
# NOTIFY_TASK_ASSIGN=true                     # 任务指派通知
# NOTIFY_REPORT_MISSING=true                  # 日报缺交提醒
# REPORT_REMIND_AT=20:00                      # 日报缺交提醒时刻（HH:MM，Asia/Shanghai），留空不提醒
# AUTO_ISSUE_ON_FAIL=true                     # auto/ci 批次 business 失败自动建缺陷草稿(与飞书通道独立)
# EXEC_AUTO_RETRY=1                           # auto/ci 批次失败自动重试次数(0=关;重试通过标 flaky 抖动)

# ===== CI/CD 集成钩子（流水线触发测试计划 + 质量门禁，可选）=====
# 生成一个长随机串填入；流水线请求带同值 X-CI-Token 头。留空则 /api/hooks/* 整条关闭。
# 用法见 docs/ci-integration.md（触发: POST /api/hooks/run-plan；门禁轮询: GET /api/hooks/gate）
CI_HOOK_TOKEN=

# multica 推送(异常会话→详细分析)。契约待定,默认 off。
# http 模式:MULTICA_MODE=http + MULTICA_URL + MULTICA_TOKEN
# cli 模式:MULTICA_MODE=cli + MULTICA_CLI_TEMPLATE(占位 {share_link}/{run_id}/{session_id})
MULTICA_MODE=off
MULTICA_URL=
MULTICA_TOKEN=
MULTICA_CLI_TEMPLATE=

# ===== DeepSeek 生成引擎（AI 测试助手的第二引擎，可选，OpenAI 兼容直调）=====
# 后端用 requests 直接调 DEEPSEEK_BASE_URL 的 /chat/completions，零额外安装、不挑平台。
# 不配置时 deepseek 引擎在前端置灰，claude 引擎不受影响。
# DEEPSEEK_ENABLED=true
# DEEPSEEK_BASE_URL=http://<内网网关>/v1           # OpenAI 兼容端点；用官方则留空
# DEEPSEEK_API_KEY=                                # 多数网关要非空；不校验也给占位值
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MAX_TOKENS=49152                        # 推理模型 reasoning 占用多，过小会截断（POC 实测）
