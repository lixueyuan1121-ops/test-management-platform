# ===== 测试管理平台 后端配置 =====
# 数据库：二选一。
# 1) MySQL（部署推荐）：设 DB_HOST 即启用，密码含 # ^ ! * 等特殊字符无需手动 URL 编码。
# DB_HOST=10.0.0.10
# DB_PORT=3306
# DB_USER=tp
# DB_PASSWORD=your-password
# DB_NAME=test_platform
# DB_CHARSET=utf8mb4
# 2) 整串（未设 DB_HOST 时生效）：默认 SQLite 本地开箱即用。
DATABASE_URL=sqlite:///./test_platform.db

# JWT
JWT_SECRET=please-change-this-secret-in-production
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS（前端地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 默认种子管理员（首次启动自动创建）
SEED_ADMIN_USERNAME=lixueyuan
SEED_ADMIN_PASSWORD=lixueyuan123
SEED_ADMIN_NAME=lixueyuan

# ===== 本地执行 runner（勾选用例下发目标机执行）=====
# runner 无人值守进程用的固定长期 token（与用户 JWT 分离）。生成一个长随机串，
# 并在各执行机 tools/qalab-runner/.env 的 RUNNER_TOKEN 填相同值。留空则拒绝一切 runner 请求。
RUNNER_TOKEN=

# ===== 飞书 OpenAPI（AI 测试助手读取飞书需求文档，可选）=====
# 在 https://open.feishu.cn 建「企业自建应用」，开通 docx/wiki/sheets/bitable 读权限，
# 并把目标文档共享给该应用，再填下面两项。留空则不支持飞书链接（普通网页不受影响）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# FEISHU_BASE=https://open.feishu.cn

# ===== DeepSeek 生成引擎（AI 测试助手的第二引擎，可选，隔离部署）=====
# dsh SDK 装在独立 venv（见 scripts/deploy-dsh.sh），后端以子进程调用，与主环境隔离。
# 不配置时 deepseek 引擎在前端置灰，claude 引擎不受影响。
# DEEPSEEK_ENABLED=true
# DEEPSEEK_VENV_PYTHON=~/.dsh-venv/bin/python     # 与 deploy-dsh.sh 的 DSH_VENV 对应
# DEEPSEEK_BASE_URL=http://<内网网关>/v1           # 用官方则留空
# DEEPSEEK_API_KEY=                                # llm-deepseek 强制要非空；网关不校验也给占位值
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MAX_TOKENS=49152                        # 推理模型输出量大，过小会被截断（POC 实测）
