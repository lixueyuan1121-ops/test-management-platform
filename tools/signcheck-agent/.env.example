# 签名校验机 agent 配置样例。复制为 .env 后填写（.env 不入库）。

# 平台地址（站点根，不带 /api）。与浏览器里访问平台的地址相同。
BASE_URL=http://11.120.81.7:4173
# 必须与平台后端 backend/.env 的 SIGNCHECK_AGENT_TOKEN 完全一致
SIGNCHECK_AGENT_TOKEN=REPLACE_WITH_SIGNCHECK_AGENT_TOKEN

# ---- 以下可选 ----
# 本机在平台上显示的名字，默认取计算机名
# AGENT_ID=win-signcheck-01
# 轮询间隔（毫秒）
# POLL_MS=3000
# 单个文件校验硬超时（毫秒），与原桌面工具一致为 120 秒
# VERIFY_TIMEOUT_MS=120000
# 校验程序路径，默认本目录 verifier\360Base_test.exe
# VERIFIER_EXE=verifier\360Base_test.exe
