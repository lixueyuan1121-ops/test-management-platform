# qalab-runner 配置样例。复制为 .env 并按平台填写。
# run.cmd(Windows)/ run.sh(Mac/Linux)会读取这些值。

# ---- 平台连接(两端通用)----
# BASE_URL 指向平台后端(注意带 /api 的接口由 runner 自己拼,这里只填站点根)
BASE_URL=http://localhost:8000
# 必须与平台后端 .env 的 RUNNER_TOKEN 完全一致(平台侧鉴权用)
RUNNER_TOKEN=REPLACE_WITH_RUNNER_TOKEN
# 本机执行机 id:Mac 用 mac-01(只跑 cli/api);有 namiclaw 的 Windows 用 win-01(跑 gui)
RUNNER_ID=mac-01
POLL_MS=5000

# ---- Claude Code ----
CLAUDE_BIN=claude

# ---- 被测客户端 namiclaw(仅执行 GUI 用例的机器需要;Mac 上没有该客户端)----
# Mac(mac-01):留空,且平台不要给 mac-01 派发 kind=gui 的用例。
NAMICLAW_EXE=
# Windows(win-01)示例:D:\Program Files\namiclaw\Application\namiclaw.exe
# Mac 若有对应客户端(.app):/Applications/namiclaw.app/Contents/MacOS/namiclaw
CDP_PORT=9222
