# qalab-runner 配置样例。复制为 .env 并按平台填写。
# run.cmd(Windows)/ run.sh(Mac/Linux)会读取这些值。

# ---- 平台连接(两端通用)----
# BASE_URL 指向平台后端(注意带 /api 的接口由 runner 自己拼,这里只填站点根)
BASE_URL=http://localhost:8000
# 必须与平台后端 .env 的 RUNNER_TOKEN 完全一致(平台侧鉴权用)
RUNNER_TOKEN=REPLACE_WITH_RUNNER_TOKEN
# 本机执行机 id:mac-01(Mac,装了 Namiwork 可跑 gui/api/cli);win-01(Windows,跑 gui)。两台共用同一 RUNNER_TOKEN、各用不同 id。
RUNNER_ID=mac-01
POLL_MS=5000

# ---- Claude Code ----
CLAUDE_BIN=claude
# claude 单次执行硬超时(ms):卡在被测页/工具时杀掉并回写 fail,避免 run 永久卡 running。默认 240000。
CLAUDE_TIMEOUT_MS=240000

# ---- 被测客户端 Namiwork(纳米Work,Electron;执行 GUI 用例的机器需要)----
# 指向 .app 内的可执行文件即可(实测 Electron 42 支持 --remote-debugging-port,CDP 通);留空=这台不跑 gui。
# Mac: /Applications/Namiwork.app/Contents/MacOS/Namiwork
# Windows(win-01)示例:D:\Program Files\namiclaw\Application\namiclaw.exe
NAMICLAW_EXE=/Applications/Namiwork.app/Contents/MacOS/Namiwork
CDP_PORT=9222

PERFDOG_DIR=
REPORT_SET_ID=

# ---- 对话测评执行器(eval/,ai-eval platform 模式)专属 ----
# 平台连接项(BASE_URL/RUNNER_TOKEN/RUNNER_ID/NAMICLAW_EXE/CDP_PORT)与上方功能测试点 runner 共用,无需重复填。
# eval 侧优先读本文件(上级 .env),故一处配置两执行器通用。
# 飞书导出(对话测评把结果导出到飞书表时用;不导出可留空):
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# DeepSeek 生成引擎(query 生成一般在平台后端,执行器侧通常留空):
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
