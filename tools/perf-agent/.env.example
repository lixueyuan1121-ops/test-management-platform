# ===== perf-agent 配置（复制为 .env 后按需修改）=====
# 平台后端地址
BASE_URL=http://localhost:8000

# runner 鉴权 token：
#  - 简单：填后端 .env 里的 RUNNER_TOKEN（共享 token）
#  - 推荐：在平台「我的工作台 → 我的设备」注册一台设备，用它返回的专属 token（归属到人，只拉到派给自己的任务）
RUNNER_TOKEN=perf-local-dev-token

# 执行机标识：与平台「任务下发」时选的执行机一致。
# 用设备专属 token 时平台按 token 反查设备，此值可留默认。
RUNNER_ID=win-01

# 本机 nami-perfdog 目录（含 nami-perfdog.mjs 与 sessions/）
PERFDOG_DIR=D:/git/test/nami-perfdog

# 轮询间隔（毫秒）
POLL_MS=5000
